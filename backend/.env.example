# --- PostgreSQL connection -------------------------------------------------
# Fill these in and copy this file to `.env` (which is git-ignored).
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=orca_scorer
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me

# --- App -------------------------------------------------------------------
APP_NAME=Orca Scorer API
DEBUG=true
# Echo every SQL statement SQLAlchemy runs (handy while learning)
SQL_ECHO=false
